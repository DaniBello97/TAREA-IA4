network tratamiento {
}
variable Tratamiento {
  type discrete [ 2 ] { no, si };
}
variable EfectoAdverso {
  type discrete [ 2 ] { no, si };
}
variable Recuperacion {
  type discrete [ 2 ] { no, si };
}
probability ( Tratamiento ) {
  table 0.5, 0.5;
}
probability ( EfectoAdverso | Tratamiento ) {
  (no) 0.9, 0.1;
  (si) 0.4, 0.6;
}
probability ( Recuperacion | Tratamiento, EfectoAdverso ) {
  (no, no) 0.4, 0.6;
  (no, si) 0.8, 0.2;
  (si, no) 0.2, 0.8;
  (si, si) 0.6, 0.4;
}
